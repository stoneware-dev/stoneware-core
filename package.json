{
  "name": "sinter",
  "version": "0.1.0",
  "description": "Bun-native, server-first web framework where HTML is the default and JavaScript is opt-in. Islands for interactivity, signals inside islands, security on before you configure anything.",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "sinter": "./bin/sinter.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./signals": "./src/signals.ts",
    "./client": "./src/client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "example": "bun run src/cli/index.ts dev --root example",
    "docs": "bun run src/cli/index.ts dev --root example",
    "prepublishOnly": "bun test && tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals-core": "^1.8.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RANJEETJ06/Sinter.git"
  },
  "homepage": "https://github.com/RANJEETJ06/Sinter#readme",
  "bugs": {
    "url": "https://github.com/RANJEETJ06/Sinter/issues"
  },
  "keywords": [
    "bun",
    "ssr",
    "islands",
    "signals",
    "server-first",
    "html",
    "web-framework",
    "csp"
  ]
}
