{
  "name": "kiln",
  "version": "0.1.0",
  "description": "Server-first, Bun-native SSR framework. Static HTML by default, islands for interactivity, signals inside islands, security on by default.",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "kiln": "./src/cli/index.ts",
    "create-kiln": "./src/cli/create.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./signals": "./src/signals.ts",
    "./client": "./src/client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "example": "bun run src/cli/index.ts dev --root example"
  },
  "dependencies": {
    "@preact/signals-core": "^1.8.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "bun",
    "ssr",
    "islands",
    "signals",
    "server-first"
  ]
}
